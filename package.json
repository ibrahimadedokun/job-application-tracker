{
  "name": "folio-job-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build && npm run infra:synth && npm run infra:verify",
    "infra:synth": "cdk synth --quiet",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "deploy": "npm run deploy:preflight && npm run check && cdk deploy --outputs-file cdk.out/outputs.json",
    "destroy": "cdk destroy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "npm run build && playwright test",
    "infra:verify": "node scripts/verify-infra.mjs",
    "azure:build": "node infra/azure/build.mjs",
    "azure:check": "pwsh -NoProfile -File infra/azure/deploy.ps1 -ValidateOnly",
    "azure:identity": "pwsh -NoProfile -File infra/azure/setup-identity.ps1",
    "azure:deploy": "pwsh -NoProfile -File infra/azure/deploy.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.922.0",
    "@aws-sdk/client-dynamodb": "^3.922.0",
    "@aws-sdk/client-sts": "^3.922.0",
    "@aws-sdk/lib-dynamodb": "^3.922.0",
    "@azure/ai-projects": "^2.11.0",
    "@azure/functions": "^4.17.1",
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.34.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "docx": "^9.15.3",
    "jose": "^6.2.17",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "oidc-client-ts": "^3.1.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^4.3.4",
    "aws-cdk": "^2.1033.0",
    "aws-cdk-lib": "^2.277.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "vite": "^6.1.0"
  }
}
