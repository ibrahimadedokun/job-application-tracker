{
  "name": "folio-job-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build && npm run infra:check",
    "infra:check": "node infra/cli.mjs check",
    "infra:init": "node infra/cli.mjs init",
    "infra:plan": "node infra/cli.mjs plan",
    "infra:output": "node infra/cli.mjs output",
    "deploy": "npm test && npm run build && node infra/cli.mjs apply",
    "deploy:publish": "npm run build && node infra/cli.mjs publish",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "npm run build && playwright test",
    "azure:build": "node infra/azure/build.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.922.0",
    "@aws-sdk/client-cloudfront": "^3.1169.0",
    "@aws-sdk/client-dynamodb": "^3.922.0",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/client-sts": "^3.922.0",
    "@aws-sdk/lib-dynamodb": "^3.922.0",
    "@azure/ai-projects": "^2.11.0",
    "@azure/functions": "^4.17.1",
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.34.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "docx": "^9.15.3",
    "jose": "^6.2.17",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "oidc-client-ts": "^3.1.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "vite": "^6.1.0"
  }
}
