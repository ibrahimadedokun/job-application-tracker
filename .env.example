# Shell examples only: export values explicitly; the app does not auto-load this file.
AWS_REGION=eu-west-2
AWS_PROFILE=your-configured-profile
# Deployment selects its target using deployment.json; see infra/README.md.
DEPLOYMENT_CONFIG=deployment.json
# Local live Bedrock only; deployment model/settings live in deployment.json.
BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# Local only: defaults true. Set false to exercise live Bedrock with credentials.
DEMO_AI=true
DATA_DIR=.local/data
