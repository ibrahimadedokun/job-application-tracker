# Shell examples only: export values explicitly; the app does not auto-load this file.
AWS_ACCOUNT_ID=123456789012
AWS_REGION=eu-west-2
AWS_PROFILE=your-configured-profile
STACK_NAME=Folio
# Check model availability/pricing in your chosen region before deployment.
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Only for inference profiles: comma-separated explicit destination model ARNs.
BEDROCK_EXTRA_MODEL_ARNS=
# Optional globally unique hosted login prefix; default folio-ACCOUNT-REGION
COGNITO_DOMAIN_PREFIX=
# Optional cost alert (not a hard spending cap)
BUDGET_EMAIL=
MONTHLY_BUDGET_USD=10
# Local only: defaults true. Set false to exercise live Bedrock with credentials.
DEMO_AI=true
DATA_DIR=.local/data
