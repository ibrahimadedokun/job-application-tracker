{
  "name": "folio-job-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build && npm run infra:synth && npm run infra:verify",
    "infra:synth": "cdk synth --app 'node infra/app.mjs' --quiet",
    "deploy": "npm run build && cdk deploy --app 'node infra/app.mjs' --require-approval never",
    "destroy": "cdk destroy --app 'node infra/app.mjs'",
    "test:e2e": "playwright test",
    "infra:verify": "node scripts/verify-infra.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.922.0",
    "@aws-sdk/client-dynamodb": "^3.922.0",
    "@aws-sdk/client-sts": "^3.922.0",
    "@aws-sdk/lib-dynamodb": "^3.922.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "oidc-client-ts": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^4.3.4",
    "aws-cdk": "^2.1033.0",
    "aws-cdk-lib": "^2.220.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "vite": "^6.1.0"
  }
}
